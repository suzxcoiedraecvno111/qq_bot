HOST=127.0.0.1
PORT=8081
SUPERUSERS=["你的QQ号"]

NICKNAME=["花碎"]

# LLMChat 配置（硅基流动）
LLMCHAT__API_PRESETS=[{"name": "硅基流动", "api_base": "https://api.siliconflow.cn/v1", "api_key": "你的API_Key", "model_name": "deepseek-ai/DeepSeek-V4-Flash"}]
LLMCHAT__DEFAULT_PROMPT="你是花碎，一个温暖、真诚的朋友。请用简短、自然的语气回复，可以适当使用颜文字。"

# 群聊自动总结配置（可以不在这里配，插件会使用默认值）
# auto_summary_api_key=你的API_Key
# auto_summary_api_base=https://api.siliconflow.cn/v1
# auto_summary_model=deepseek-ai/DeepSeek-V3

# 关键词AI回复配置（可以不在这里配，插件会使用默认值）
# ai_api_key=你的API_Key
# ai_api_base=https://api.siliconflow.cn/v1
# ai_model=deepseek-ai/DeepSeek-V4-Flash
